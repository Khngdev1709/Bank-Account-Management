<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.project01.bankaccountmanagement.presentation.AccountFormController">

    <top>
        <Label text="TRANSACTION MANAGEMENT"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="15" bottom="15"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <!-- Form tạo tài khoản -->
            <GridPane hgap="10" vgap="10">

                <Label text="Customer:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="cbCustomer"
                          prefWidth="250"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Account Number:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtAccountNumber"
                           prefWidth="250"
                           promptText="Enter account number"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Button text="Create Account"
                        onAction="#handleCreateAccount"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

            </GridPane>

            <!-- Danh sách tài khoản -->
            <Label text="Account List"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TableView fx:id="tblAccounts"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colAccountID"
                                 text="Account ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colCustomerID"
                                 text="Customer ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colAccountNumber"
                                 text="Account Number"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colBalance"
                                 text="Balance"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colStatus"
                                 text="Status"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colCreatedAt"
                                 text="Created At"
                                 prefWidth="180"/>

                </columns>

            </TableView>

            <!-- Update Status -->
            <HBox spacing="10"
                  alignment="CENTER_LEFT">

                <Label text="Selected Account Status:"/>

                <ComboBox fx:id="cbStatus"
                          prefWidth="150"/>

                <Button text="Update Status"
                        onAction="#handleUpdateStatus"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>